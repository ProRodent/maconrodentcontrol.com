{
  "version": "1.0",
  "source_audit": "maconrodentcontrol.com R&R Penalty-Risk Audit (Batches 1-4)",
  "applies_to": "all future content generation for this site and sibling R&R sites",
  "banned_lexical_markers": [
    "delve into", "delving into",
    "navigate the complexities", "navigating the landscape",
    "in today's fast-paced world", "in today's digital age",
    "it's important to note", "it's worth noting", "it's crucial to understand",
    "tapestry", "realm (as metaphor)",
    "robust", "comprehensive", "seamless", "cutting-edge",
    "state-of-the-art", "world-class", "top-notch", "industry-leading",
    "meticulous", "meticulously",
    "underscore", "underscores the importance",
    "leverage", "leveraging",
    "elevate your", "transform your", "unlock the",
    "at the heart of", "at the forefront",
    "whether you're X or Y (binary opener)",
    "look no further",
    "rest assured", "rest easy",
    "you can count on us", "you can trust",
    "we pride ourselves",
    "from start to finish", "from beginning to end",
    "peace of mind",
    "in conclusion", "to sum up", "in summary"
  ],
  "banned_latinate_inflation": {
    "comprehensive": "full",
    "comprehensively": "fully",
    "substantially": "much",
    "substantial": "big",
    "particularly": "especially",
    "approximately": "about",
    "consequently": "so",
    "specifically": "(remove or 'exactly')",
    "additionally": "also",
    "significantly": "a lot",
    "significant": "major",
    "typically": "usually",
    "primarily": "mostly",
    "essentially": "really",
    "potentially": "maybe",
    "documentation": "records",
    "documented": "recorded",
    "infrastructure": "system",
    "installation": "work",
    "assessment": "check",
    "particular": "specific",
    "determination": "choice",
    "indicates": "shows",
    "indicators": "signs",
    "maintenance": "upkeep",
    "permanent": "lasting",
    "sufficient": "enough",
    "appropriate": "right",
    "therefore": "so",
    "moreover": "and",
    "furthermore": "also",
    "accordingly": "so",
    "nonetheless": "still",
    "nevertheless": "still",
    "utilize": "use",
    "utilization": "use",
    "implement": "do",
    "implementation": "doing"
  },
  "banned_syntactic_patterns": [
    "Em-dash as comma replacement (max 2 per 1000 words sitewide)",
    "Triple dash `---` in body content (NEVER)",
    "Negative parallelism: 'It's not just X — it's Y'",
    "Negative parallelism: 'This isn't about A, it's about B'",
    "Negative parallelism: 'These aren't X — they're Y'",
    "Tricolon abuse: rule-of-three with abstract third item",
    "Gerund openers in paragraphs (>15% of paragraph starts)",
    "'When it comes to X' opener (banned entirely)",
    "Variable-shaped sentences where city/service is the subject",
    "Sentences ending with one-line summary",
    "FAQ answers all opening with 'Yes,'/'No,'/'Absolutely,'",
    "Paragraphs uniformly in 40-80 word band"
  ],
  "forbidden_schema_types": [
    "Review",
    "AggregateRating",
    "HowTo"
  ],
  "forbidden_content": [
    "Testimonials with named customers",
    "Star ratings or review counts",
    "License numbers (real or placeholder)",
    "Founded-year claims without verification",
    "Stock-photo-pattern names ('John D.', 'Sarah M.')",
    "BBB or trust badges without working links",
    "Promise inflation ('guaranteed', '100%', '#1', 'always')",
    "Years-of-experience claims contradicting domain age"
  ],
  "structural_limits": {
    "em_dashes_per_1000_words_max": 2,
    "ctas_per_service_page_body_max": 3,
    "footer_city_links_max": 50,
    "internal_anchor_exact_match_keyword_max_pct": 10,
    "skeleton_groups_max_pages_each": 1,
    "boilerplate_sentence_max_pages": 2,
    "fact_density_per_100w_min": 1.0,
    "concrete_facts_per_100w_target": "2-4"
  }
}
